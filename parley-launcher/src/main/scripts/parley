#!/bin/sh
# Runs a Parley program on a Java installed on this machine. Each program is a link to this file,
# named for it (fsh, fsh-ide, pssh ...); PREFIX/apps/NAME.properties names the program's artifact
# (artifact=group:artifact:version). The jars it needs are found in the machine repository, then in
# the user's (~/.m2/repository), or downloaded from Maven Central into the user's; the command that
# runs it is saved (~/.parley/launcher/cache/NAME.args), so the next start only checks that the
# files it was made from haven't changed, and runs it: no other JVM, no network.
#
# Run under its own name (parley; parley-launcher, its earlier name, still works) it manages the
# programs:
#   parley add NAME                  add a program the launcher knows by name (parley available),
#                                    picking from the versions found (the newest release is the default)
#   parley add NAME VERSION          that version of it
#   parley add NAME [GROUP:]ARTIFACT[:VERSION] [MAIN]
#                                    add any program: no GROUP: us.bringardner, else
#                                    us.bringardner.parley; MAIN: another main class in that jar
#   parley available                 the programs the launcher knows by name
#   parley list                      the programs added, and their artifacts
#   parley update [NAME ...]         move the programs (or just those named) to their newest version
#   parley remove NAME               remove one
#   parley versions [GROUP:]ARTIFACT the versions found, newest first
#   parley command NAME              the command NAME runs (made if need be)
#   parley java                      the Java the programs run on
#   parley java install              download a Java for the launcher's own use (Eclipse Temurin)
#   parley java update               replace a Java the launcher downloaded with the newest
#   parley --version
#
# Settings (environment variables):
#   JAVA_HOME                   its java when that is 11 or later, else the newest Java found
#   PARLEY_JAVA                 the java executable to use
#   PARLEY_INSTALL_JAVA         when no Java 11 or later is found: yes: download one without asking;
#                               no: never; otherwise the launcher asks (when there is a terminal to ask on)
#   PARLEY_JAVA_VERSION         the Java to download (21, 25 ...) instead of the newest long-term one
#   PARLEY_JAVA_API             instead of https://api.adoptium.net/v3 (where a Java is downloaded from)
#   PARLEY_REFRESH=1            make the command again (after installing a newer Java, say)
#   PARLEY_OFFLINE=true         download nothing
#   PARLEY_MACHINE_REPOSITORY   instead of /usr/local/lib/parley/repository
#   PARLEY_USER_REPOSITORY      instead of ~/.m2/repository (or settings.xml's localRepository)
#   PARLEY_CENTRAL              instead of https://repo1.maven.org/maven2/
#   PARLEY_SNAPSHOTS            instead of https://central.sonatype.com/repository/maven-snapshots/
#                               (where a SNAPSHOT not installed here comes from; none: nowhere)
#   PARLEY_LAUNCHER_HOME        instead of ~/.parley/launcher (the saved commands, native files)
#   JDK_JAVA_OPTIONS            more options for java (java itself reads it)

min=11
# (cd prints the folder when CDPATH finds it, which would end up in the paths below)
unset CDPATH

die() {
	echo "$app: $*" >&2
	exit 1
}

app=$(basename "$0")

# PREFIX: this file's folder's parent, through any links to it (/usr/local/bin/fsh -> ...)
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
prefix=$(cd "$(dirname "$self")/.." && pwd)
jar=$prefix/lib/parley-launcher.jar
home=${PARLEY_LAUNCHER_HOME:-$HOME/.parley/launcher}

# ---- the saved command

# (what, besides the files it was made from, the saved command depends on)
key="2|$JAVA_HOME|$PARLEY_JAVA|$PARLEY_MACHINE_REPOSITORY|$PARLEY_USER_REPOSITORY|$PARLEY_CENTRAL|$PARLEY_SNAPSHOTS|$PARLEY_OFFLINE"

# true when NAME's saved command is current: its key is this one, and every file it was made from
# is there and no newer than it ("!" FILE: is still not there; "until SECONDS": that time hasn't come,
# for a downloaded SNAPSHOT, whose newer build is looked for a day later)
current() {
	c=$home/cache/$1
	[ -f "$c.args" ] && [ -f "$c.check" ] || return 1
	[ "$c.check" -nt "$c.args" ] && return 1
	IFS= read -r k < "$c.args" || return 1
	[ "$k" = "$key" ] || return 1
	while IFS= read -r f; do
		case $f in
		'') ;;
		retry) return 1 ;;
		until\ *) [ "$(date +%s)" -lt "${f#until }" ] || return 1 ;;
		!*) [ -e "${f#!}" ] && return 1 ;;
		*) { [ -e "$f" ] && [ ! "$f" -nt "$c.args" ]; } || return 1 ;;
		esac
	done < "$c.check"
	return 0
}

# ---- Java

# The major version of a java executable (8, 11, 17, 21 ...): from its JDK's release file, which
# needs no JVM started, else from java -version; "1.8.0_392" and "17.0.9" / "25-ea" both
java_major() {
	j=$1
	r=$(readlink -f "$j" 2>/dev/null) && [ -n "$r" ] && j=$r
	h=$(cd "$(dirname "$j")/.." 2>/dev/null && pwd)
	v=$(sed -n 's/^JAVA_VERSION="\([^"]*\)".*/\1/p' "$h/release" 2>/dev/null)
	if [ -z "$v" ]; then
		v=$("$j" -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -n 1)
	fi
	case $v in
	1.*) v=${v#1.} ;;
	esac
	v=${v%%[.+_-]*}
	case $v in
	'' | *[!0-9]*) return 1 ;;
	esac
	echo "$v"
}

# java: PARLEY_JAVA, else JAVA_HOME's when it is new enough, else the newest found
find_java() {
	if [ -n "$PARLEY_JAVA" ]; then
		# (a name or a relative path: the java it means, as a path that stays right from any folder)
		j=$PARLEY_JAVA
		case $j in
		*/*) [ -x "$j" ] && j=$(cd "$(dirname "$j")" && pwd)/$(basename "$j") ;;
		*) j=$(command -v "$j" 2>/dev/null) || j=$PARLEY_JAVA ;;
		esac
		v=$(java_major "$j") || die "PARLEY_JAVA=$PARLEY_JAVA is not a java executable"
		[ "$v" -ge "$min" ] || die "PARLEY_JAVA=$PARLEY_JAVA is Java $v; Java $min or later is needed"
		java=$j
		return
	fi
	if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ] && v=$(java_major "$JAVA_HOME/bin/java") && [ "$v" -ge "$min" ]; then
		java=$JAVA_HOME/bin/java
		return
	fi
	candidates=""
	add() {
		[ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ] || return 0
		j=$1
		r=$(readlink -f "$j" 2>/dev/null) && [ -n "$r" ] && j=$r
		case "
$candidates
" in
		*"
$j
"*) return 0 ;;
		esac
		candidates="$candidates
$j"
	}
	os=$(uname -s)
	if [ "$os" = Darwin ] && [ -x /usr/libexec/java_home ]; then
		h=$(/usr/libexec/java_home -v "$min+" 2>/dev/null) && add "$h/bin/java"
	fi
	if p=$(command -v java 2>/dev/null); then
		# (macOS's /usr/bin/java with no JDK installed opens an "install Java" dialog: not that)
		if [ "$os" != Darwin ] || [ "$p" != /usr/bin/java ] || /usr/libexec/java_home > /dev/null 2>&1; then
			add "$p"
		fi
	fi
	for j in \
		"$prefix"/java/*/bin/java \
		"$prefix"/java/*/Contents/Home/bin/java \
		"$home"/java/*/bin/java \
		"$home"/java/*/Contents/Home/bin/java \
		/Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java \
		"$HOME"/Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java \
		/usr/lib/jvm/*/bin/java \
		/usr/java/*/bin/java \
		/opt/java/*/bin/java \
		/opt/jdk*/bin/java \
		/opt/homebrew/opt/openjdk*/bin/java \
		/usr/local/opt/openjdk*/bin/java \
		"$HOME"/.sdkman/candidates/java/*/bin/java \
		"$HOME"/.jdks/*/bin/java; do
		add "$j"
	done
	best=0
	java=""
	older=""
	while IFS= read -r j; do
		[ -n "$j" ] || continue
		v=$(java_major "$j") || continue
		if [ "$v" -ge "$min" ]; then
			if [ "$v" -gt "$best" ]; then
				best=$v
				java=$j
			fi
		else
			older="$older
    Java $v: $j"
		fi
	done <<EOF
$candidates
EOF
	if [ -z "$java" ]; then
		{
			echo "$app: Java $min or later is needed, and none was found on this computer."
			[ -n "$older" ] && echo "These are installed but too old:$older"
		} >&2
		# (the launcher can download one for its own use, when the person says so)
		if offer_java; then
			return
		fi
		{
			echo "Install a JDK $min or later (for example from https://adoptium.net), or set JAVA_HOME"
			echo "(or PARLEY_JAVA) to one, and run $app again. Or let the launcher download one for its"
			echo "own use: parley java install"
		} >&2
		exit 1
	fi
}

# ---- downloading a Java (Eclipse Temurin, from adoptium.net) for the launcher's own use

# Where a downloaded Java is kept: the installation's folder when root runs this (for everyone),
# else the user's (~/.parley/launcher/java). It is not put on the PATH; only the launcher uses it.
java_dir() {
	if [ "$(id -u)" -eq 0 ]; then
		echo "$prefix/java"
	else
		echo "$home/java"
	fi
}

# fetch URL FILE [show]: download URL into FILE (show: with a progress bar, when curl has one)
fetch() {
	if command -v curl > /dev/null 2>&1; then
		if [ -n "$3" ] && [ -t 2 ]; then
			curl -fL --retry 2 -# -o "$2" "$1"
		else
			curl -fsSL --retry 2 -o "$2" "$1"
		fi
	elif command -v wget > /dev/null 2>&1; then
		wget -q -O "$2" "$1"
	else
		return 127
	fi
}

# a file's SHA-256, in hex
sha256_of() {
	if command -v sha256sum > /dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	elif command -v shasum > /dev/null 2>&1; then
		shasum -a 256 "$1" | cut -d' ' -f1
	elif command -v openssl > /dev/null 2>&1; then
		openssl dgst -sha256 "$1" | sed 's/.*= *//'
	else
		return 1
	fi
}

# the java executable in a downloaded Java's folder (macOS keeps it under Contents/Home), or nothing
java_in() {
	if [ -x "$1/bin/java" ]; then
		echo "$1/bin/java"
	elif [ -x "$1/Contents/Home/bin/java" ]; then
		echo "$1/Contents/Home/bin/java"
	fi
}

# Ask whether to download a Java (PARLEY_INSTALL_JAVA=yes: no question; no: never; with no terminal to
# ask on, it isn't downloaded), and download it. Returns 0 with $java set when one was installed.
offer_java() {
	case ${PARLEY_INSTALL_JAVA:-ask} in
	yes | true | 1) ;;
	no | false | 0) return 1 ;;
	*)
		[ -t 0 ] && [ -t 2 ] || return 1
		printf '%s' "Download Java now, for the Parley programs only (Eclipse Temurin, about 50 MB, into $(java_dir))? [Y/n] " >&2
		IFS= read -r answer || return 1
		case $answer in
		'' | y | Y | yes | Yes | YES) ;;
		*) return 1 ;;
		esac ;;
	esac
	install_java
}

# Download the newest long-term-support Java for this platform into java_dir, checked against the
# SHA-256 adoptium.net gives for it. Returns 0 with $java set to its java; 1, with the reason said,
# when it can't be done. One that was downloaded before is used as it is.
install_java() {
	case $(uname -s) in
	Darwin) jos=mac ;;
	Linux)
		jos=linux
		# (Alpine's C library is another one, with its own build)
		[ -f /etc/alpine-release ] && jos=alpine-linux ;;
	*)
		echo "$app: there is no Java to download for $(uname -s)" >&2
		return 1 ;;
	esac
	case $(uname -m) in
	x86_64 | amd64) jarch=x64 ;;
	arm64 | aarch64) jarch=aarch64 ;;
	*)
		echo "$app: there is no Java to download for $(uname -m)" >&2
		return 1 ;;
	esac
	command -v tar > /dev/null 2>&1 || { echo "$app: downloading Java needs tar" >&2; return 1; }
	api=${PARLEY_JAVA_API:-https://api.adoptium.net/v3}
	jdest=$(java_dir)
	jtmp=$jdest/.download.$$
	mkdir -p "$jtmp/unpacked" || { echo "$app: can't write to $jdest" >&2; return 1; }
	trap 'rm -rf "$jtmp"; exit 130' INT TERM
	jfeature=$PARLEY_JAVA_VERSION
	if [ -z "$jfeature" ]; then
		fetch "$api/info/available_releases" "$jtmp/releases.json"
		case $? in
		0) ;;
		127)
			rm -rf "$jtmp"; trap - INT TERM
			echo "$app: downloading Java needs curl or wget" >&2
			return 1 ;;
		*)
			rm -rf "$jtmp"; trap - INT TERM
			echo "$app: can't reach $api to download Java" >&2
			return 1 ;;
		esac
		jfeature=$(sed -n 's/.*"most_recent_lts": *\([0-9][0-9]*\).*/\1/p' "$jtmp/releases.json" | head -n 1)
	fi
	case $jfeature in
	'' | *[!0-9]*)
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: can't tell which Java to download (PARLEY_JAVA_VERSION=21 names one)" >&2
		return 1 ;;
	esac
	if ! fetch "$api/assets/latest/$jfeature/hotspot?architecture=$jarch&image_type=jre&os=$jos&vendor=eclipse" "$jtmp/asset.json"; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: can't reach $api to download Java $jfeature" >&2
		return 1
	fi
	# (the archive's entry: "package": { "checksum": ..., "link": ..., "name": ... }; a macOS
	# release also has an "installer" entry, which is not it)
	jpkg=$(sed -n '/"package": *{/,/}/p' "$jtmp/asset.json")
	jlink=$(printf '%s\n' "$jpkg" | sed -n 's/.*"link": *"\([^"]*\)".*/\1/p' | head -n 1)
	jsum=$(printf '%s\n' "$jpkg" | sed -n 's/.*"checksum": *"\([0-9a-fA-F]*\)".*/\1/p' | head -n 1)
	case $jlink in
	https://*.tar.gz) ;;
	*)
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: adoptium.net has no Java $jfeature for $jos $jarch" >&2
		return 1 ;;
	esac
	if [ -z "$jsum" ]; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: adoptium.net gave no checksum for $jlink: it is not downloaded" >&2
		return 1
	fi
	# (downloaded before: its folder says which archive it came from)
	for m in "$jdest"/*/.parley-java; do
		if [ -f "$m" ] && [ "$(cat "$m")" = "$jlink" ]; then
			j=$(java_in "$(dirname "$m")")
			if [ -n "$j" ]; then
				rm -rf "$jtmp"; trap - INT TERM
				java=$j
				java_was_there=yes
				return 0
			fi
		fi
	done
	echo "$app: downloading Java $jfeature from $jlink" >&2
	if ! fetch "$jlink" "$jtmp/java.tar.gz" show; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: the download failed" >&2
		return 1
	fi
	jgot=$(sha256_of "$jtmp/java.tar.gz") || {
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: the download can't be checked (no sha256sum, shasum or openssl here): it is not used" >&2
		return 1
	}
	if [ "$jgot" != "$(printf '%s' "$jsum" | tr 'A-F' 'a-f')" ]; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: the Java downloaded does not match its SHA-256 ($jgot, adoptium.net says $jsum): it is not used" >&2
		return 1
	fi
	if ! tar -xzf "$jtmp/java.tar.gz" -C "$jtmp/unpacked"; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: can't unpack the Java downloaded" >&2
		return 1
	fi
	jtop=$(ls "$jtmp/unpacked" | head -n 1)
	j=""
	[ -n "$jtop" ] && j=$(java_in "$jtmp/unpacked/$jtop")
	if [ -z "$j" ] || ! java_major "$j" > /dev/null; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: what was downloaded is not a Java for this computer" >&2
		return 1
	fi
	printf '%s\n' "$jlink" > "$jtmp/unpacked/$jtop/.parley-java"
	rm -rf "$jdest/$jtop"
	if ! mv "$jtmp/unpacked/$jtop" "$jdest/$jtop"; then
		rm -rf "$jtmp"; trap - INT TERM
		echo "$app: can't write to $jdest" >&2
		return 1
	fi
	rm -rf "$jtmp"
	trap - INT TERM
	# (for everyone, when root put it in the installation's folder)
	chmod -R a+rX "$jdest" 2> /dev/null
	java=$(java_in "$jdest/$jtop")
	java_was_there=""
	echo "$app: Java $jfeature is in $jdest/$jtop" >&2
	return 0
}

# Make NAME's saved command (the launcher works it out, fetching what is missing)
resolve() {
	f=$prefix/apps/$1.properties
	[ -f "$f" ] || die "there is no program $1 here ($f): parley add $1"
	[ -f "$jar" ] || die "$jar is missing: keep the folder parley was installed in together"
	find_java
	mkdir -p "$home/cache" || exit 1
	"$java" -XX:TieredStopAtLevel=1 -Xshare:auto -jar "$jar" resolve --app "$1" --app-file "$f" \
		--java "$java" --cache "$home/cache/$1" --key "$key" || exit $?
}

# Run NAME's saved command with these arguments after it
run() {
	c=$home/cache/$1
	shift
	n=$#
	first=yes
	while IFS= read -r line; do
		if [ -n "$first" ]; then
			first=""
			continue
		fi
		set -- "$@" "$line"
	done < "$c.args"
	# (the program's arguments, first in "$@" so far, to the end)
	i=0
	while [ "$i" -lt "$n" ]; do
		a=$1
		shift
		set -- "$@" "$a"
		i=$((i + 1))
	done
	exec "$@"
}

# ---- parley's own commands

if [ "$app" = parley ] || [ "$app" = parley-launcher ]; then
	app=parley
	bin=""
	[ -f "$prefix/launcher.conf" ] && bin=$(sed -n 's/^bin=//p' "$prefix/launcher.conf")
	case $1 in
	--version)
		find_java
		exec "$java" -jar "$jar" --version ;;
	add | update | remove)
		# (an installation for every user is changed by an administrator: through sudo, as install.sh
		# does, by this script's full path, since sudo's PATH often has no /usr/local/bin. The versions
		# this user has installed with mvn install stay in the list to pick from; as root nothing is
		# written there)
		d=$prefix/apps
		[ -d "$d" ] || d=$prefix
		if [ "$(id -u)" -ne 0 ] && [ ! -w "$d" ] && [ -z "$PARLEY_SUDO" ] && command -v sudo > /dev/null 2>&1; then
			echo "parley: the launcher in $prefix is every user's, so this needs administrator rights: sudo may ask for your password." >&2
			set -- "$prefix/bin/parley" "$@"
			for v in PARLEY_OFFLINE PARLEY_CENTRAL PARLEY_SNAPSHOTS PARLEY_MACHINE_REPOSITORY PARLEY_JAVA JAVA_HOME; do
				eval "x=\${$v}"
				[ -z "$x" ] || set -- "$v=$x" "$@"
			done
			exec sudo env PARLEY_SUDO=1 "PARLEY_USER_REPOSITORY=${PARLEY_USER_REPOSITORY:-$HOME/.m2/repository}" "$@"
		fi
		[ -f "$jar" ] || die "$jar is missing: keep the folder parley was installed in together"
		find_java
		if [ "$1" = remove ]; then
			exec "$java" -jar "$jar" --prefix "$prefix" --bin "$bin" --home "$home" "$@"
		fi
		if [ "$(id -u)" -eq 0 ]; then
			# (as root, for everyone: each user's command is made at their first start, in their own
			# repository and cache; made here, root would own files in a home sudo kept)
			exec "$java" -jar "$jar" --prefix "$prefix" --bin "$bin" --home "$home" "$@"
		fi
		# (the command is made now, so a missing jar or SNAPSHOT shows here, not at the first start)
		exec "$java" -jar "$jar" --prefix "$prefix" --bin "$bin" --home "$home" --java "$java" --key "$key" "$@" ;;
	list | available)
		[ -f "$jar" ] || die "$jar is missing: keep the folder parley was installed in together"
		find_java
		exec "$java" -jar "$jar" --prefix "$prefix" --bin "$bin" --home "$home" "$@" ;;
	versions)
		[ $# -eq 2 ] || { echo "usage: parley versions [GROUP:]ARTIFACT[:VERSION]" >&2; exit 2; }
		find_java
		exec "$java" -jar "$jar" versions "$2" ;;
	java)
		case ${2:-show} in
		show)
			[ $# -le 1 ] || { echo "usage: parley java [install | update]" >&2; exit 2; }
			find_java
			echo "$java (Java $(java_major "$java"))"
			exit 0 ;;
		install)
			[ $# -eq 2 ] || { echo "usage: parley java install" >&2; exit 2; }
			install_java || exit 1
			[ -z "$java_was_there" ] || echo "the newest Java is here already" >&2
			echo "$java (Java $(java_major "$java"))"
			exit 0 ;;
		update)
			[ $# -eq 2 ] || { echo "usage: parley java update" >&2; exit 2; }
			jdest=$(java_dir)
			had=""
			for m in "$jdest"/*/.parley-java; do
				[ -f "$m" ] && had=yes
			done
			[ -n "$had" ] || { echo "the launcher has downloaded no Java into $jdest: there is nothing to update (parley java install downloads one)"; exit 0; }
			install_java || exit 1
			if [ -n "$java_was_there" ]; then
				echo "the newest Java is here already: $java"
				exit 0
			fi
			# (the ones downloaded before go; the programs' commands are made again at their next start)
			for m in "$jdest"/*/.parley-java; do
				[ -f "$m" ] || continue
				d=$(dirname "$m")
				[ "$(java_in "$d")" = "$java" ] || rm -rf "$d"
			done
			echo "$java (Java $(java_major "$java"))"
			exit 0 ;;
		*)
			echo "usage: parley java [install | update]" >&2
			exit 2 ;;
		esac ;;
	command)
		[ $# -eq 2 ] || { echo "usage: parley command NAME" >&2; exit 2; }
		app=$2
		if [ -n "$PARLEY_REFRESH" ] || ! current "$app"; then
			resolve "$app"
		fi
		tail -n +2 "$home/cache/$app.args"
		exit 0 ;;
	*)
		sed -n '2,/^$/s/^# \{0,1\}//p' "$self"
		[ -z "$1" ] || [ "$1" = --help ] || exit 2
		exit 0 ;;
	esac
fi

# ---- a program

if [ -n "$PARLEY_REFRESH" ] || ! current "$app"; then
	resolve "$app"
fi
run "$app" "$@"
