<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
		<relativePath>../../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-launcher-maven-plugin</artifactId>
	<packaging>maven-plugin</packaging>
	<name>Parley Launcher Maven Plugin</name>
	<description>
		Writes, as a program is built, what parley-launcher needs to run it into its jar
		(META-INF/parley/launcher.list): its main class and Java options, and every jar on its run-time
		class path with that jar's SHA-256.
	</description>
	<inceptionYear>2026</inceptionYear>

	<properties>
		<parley.moduleName>us.bringardner.parley.launcher.maven</parley.moduleName>
		<maven.version>3.9.11</maven.version>
		<maven.plugin.tools.version>3.15.1</maven.plugin.tools.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-plugin-plugin</artifactId>
				<version>${maven.plugin.tools.version}</version>
				<configuration>
					<goalPrefix>parley-launcher</goalPrefix>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- the list's format, shared with the launcher that reads it -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-launcher</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-plugin-api</artifactId>
			<version>${maven.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-core</artifactId>
			<version>${maven.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.maven.plugin-tools</groupId>
			<artifactId>maven-plugin-annotations</artifactId>
			<version>${maven.plugin.tools.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>
</project>
